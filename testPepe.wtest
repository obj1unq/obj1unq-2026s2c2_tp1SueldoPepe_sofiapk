import pepe.*

describe "Sueldo Pepe" {
	
	test "Pepe con $20.800 de sueldo" {
		// es cadete, tiene el bono resultado de monto fijo, y bono presentismo normal. Simular que faltó 3 días. Debería tener $20800 de sueldo.
		pepe.categoría(cadete)
		pepe.bonoPorResultados(montoFijo)
		pepe.bonoPorPresentismo(normal)
		pepe.ausencias(3)
		assert.equals(20800, pepe.sueldo())
	}

	test "Pepe con $16.500 de sueldo" {
		// Si pepe es gerente, tiene el bono resultado por porcentaje, y bono de presentismo nulo.
		pepe.categoría(gerente)
		pepe.bonoPorResultados(porcentaje)
		pepe.bonoPorPresentismo(bonoNulo)
		pepe.ausencias(0)
		assert.equals(16500, pepe.sueldo())
	}

	test "Pepe con $24.000 de sueldo" {
		// Si pepe es cadete, tiene bono de resultados por porcentaje, bono por presentismo normal, nunca faltó. Debería tener $24000 de sueldo.
		pepe.categoría(cadete)
		pepe.bonoPorResultados(porcentaje)
		pepe.bonoPorPresentismo(normal)
		pepe.ausencias(0)
		assert.equals(24000, pepe.sueldo())
	}

	test "Pepe con $23.000 de sueldo" {
		// Si pepe es cadete, tiene bono de resultados por porcentaje, bono por presentismo normal, falto 1 día. Debería tener $23000 de sueldo.
		pepe.categoría(cadete)
		pepe.bonoPorResultados(porcentaje)
		pepe.bonoPorPresentismo(normal)
		pepe.ausencias(1)
		assert.equals(23000, pepe.sueldo())
	}
}